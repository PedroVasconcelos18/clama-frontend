# Base das chamadas de API feitas pelo NAVEGADOR.
# Vazio = caminho relativo, resolvido pelo rewrite de `/api/*`:
#   - produção: regra no vercel.json
#   - dev:      server.proxy do Vite (VITE_DEV_API_PROXY_TARGET abaixo)
VITE_API_URL=

# Base ABSOLUTA usada só pelo prerender do Vike, que roda em Node.
# `fetch` em Node não resolve caminho relativo — com VITE_API_URL vazio, sem
# esta variável o `npm run build` quebra em pages/blog/**/+data.ts.
VITE_API_URL_SSR=http://localhost:8000

# Destino do proxy de /api no dev server. Default: http://localhost:8000
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Hosts permitidos pelo dev server do Vite (separados por vírgula).
VITE_ALLOWED_HOSTS=.ngrok-free.dev,.ngrok-free.app,.trycloudflare.com

# Cloudflare Turnstile site key (público).
# Default sandbox always-pass para dev/test:
#   1x00000000000000000000AA  → sempre passa
#   2x00000000000000000000AB  → sempre falha
#   3x00000000000000000000FF  → força challenge interativo
# Em produção, configure a chave real do widget criada no painel da Cloudflare.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
